#!/usr/bin/env python3
"""sgditto: turn a list of paths (e.g. `find .` output) into an
indentation-based file tree that folds nicely in vim with
`:set foldmethod=indent`.
"""
import argparse
import sys


def build_tree(lines):
    tree = {}
    for line in lines:
        line = line.strip()
        if not line:
            continue
        parts = [p for p in line.split("/") if p not in ("", ".")]
        node = tree
        for part in parts:
            node = node.setdefault(part, {})
    return tree


def emit(tree, indent, out):
    def walk(node, depth):
        for name in sorted(node, key=str.lower):
            out.write(f"{indent * depth}{name}\n")
            walk(node[name], depth + 1)

    walk(tree, 0)


def main(argv=None):
    parser = argparse.ArgumentParser(
        description=(
            "Build an indentation-based file tree from a list of paths "
            "(as produced by `find .`), suitable for folding in vim with "
            "':set foldmethod=indent'."
        )
    )
    parser.add_argument(
        "files",
        nargs="*",
        help="files containing paths, one per line (default: stdin)",
    )
    parser.add_argument(
        "-i",
        "--indent-size",
        type=int,
        default=2,
        help="number of spaces per tree level (default: 2)",
    )
    args = parser.parse_args(argv)

    lines = []
    if args.files:
        for path in args.files:
            with open(path) as f:
                lines.extend(f.read().splitlines())
    else:
        lines.extend(sys.stdin.read().splitlines())

    tree = build_tree(lines)
    emit(tree, " " * args.indent_size, sys.stdout)


if __name__ == "__main__":
    main()
