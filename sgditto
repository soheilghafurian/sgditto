#!/bin/sh
# sgditto: turn a list of paths (e.g. `find .` output) into an
# indentation-based file tree that folds nicely in vim with
# `:set foldmethod=indent`.
#
# POSIX sh + awk + sort only -- no interpreter or package beyond what
# ships on essentially any unix-like machine.
set -eu

indent_size=2

usage() {
    cat <<'EOF'
Usage: sgditto [-i N] [FILE...]

Build an indentation-based file tree from a list of paths (as
produced by `find .`), suitable for folding in vim with
':set foldmethod=indent'.

  -i N   number of spaces per tree level (default: 2)
  FILE   read paths from FILE instead of stdin (may repeat)
EOF
}

while getopts "i:h" opt; do
    case "$opt" in
        i) indent_size=$OPTARG ;;
        h) usage; exit 0 ;;
        *) usage >&2; exit 1 ;;
    esac
done
shift $((OPTIND - 1))

cat "$@" | awk '
{
    line = $0
    gsub(/^[ \t]+|[ \t]+$/, "", line)
    if (line == "") next

    n = split(line, parts, "/")
    prefix = ""
    for (i = 1; i <= n; i++) {
        if (parts[i] == "") continue
        prefix = (prefix == "" ? parts[i] : prefix "/" parts[i])
        print prefix
    }
}
' | LC_ALL=C sort -u | LC_ALL=C sort -f | awk -v indent_size="$indent_size" '
{
    n = split($0, parts, "/")
    depth = n - 1
    pad = ""
    for (i = 0; i < depth * indent_size; i++) pad = pad " "
    print pad parts[n]
}
'
