#!/bin/sh
# sgditto: turn a list of paths (e.g. `find .` output) into an
# indentation-based file tree that folds nicely in vim with
# `:set foldmethod=indent`.
#
# POSIX sh + awk only -- no interpreter or package beyond what ships
# on essentially any unix-like machine.
set -eu

indent=" "
repeat_count=2
separator="/"
gron_mode=0
subcommand="tree"

usage() {
    cat <<'EOF'
Usage: sgditto [tree] [-i STR] [-n N] [-s SEP] [-g] [FILE...]
       sgditto paths [-i STR] [-n N] [-s SEP] [-g] [FILE...]

tree (default): build an indentation-based file tree from a path
list (as produced by `find .`), suitable for folding in vim with
':set foldmethod=indent'.

paths: the reverse -- reconstruct a path list from an indentation
tree (as produced by this command), using the same -i/-n/-s/-g given
when the tree was built.

  -i STR   the indent string itself (default: " ", a space); may be
           more than one character. Note: vim's foldmethod=indent
           only recognizes actual whitespace (spaces/tabs) as indent,
           so a non-whitespace -i will not fold in vim.
  -n N     number of times to repeat -i per tree level (default: 2)
  -s SEP   separator between path components (default: /); may be
           more than one character
  -g       gron mode: each line is `path = value;` (as produced by
           gron); only the path is used to build/read the tree, and
           the " = value;" part is kept on the leaf line instead of
           being parsed as more path. Lines with no " = " are
           treated as plain paths, same as without -g.
  FILE     read input from FILE instead of stdin (may repeat)

Examples:
  find . | sgditto
      Tree of the current directory, ready to pipe into vim.

  find . | sgditto > tree.txt && vim tree.txt
      Save the tree, then in vim: :set foldmethod=indent

  sgditto -n 4 < paths.txt
      Use 4 spaces per level instead of the default 2.

  sgditto -i '.' < paths.txt
      Use "." as the indent string instead of spaces (for display
      only -- this will not fold in vim; see the -i note above).

  sgditto -s '::' < paths.txt
      Paths are separated by "::" instead of "/".

  gron file.json | sgditto -g -s .
      Tree of a JSON file's structure, values kept on each leaf line.

  sgditto paths < tree.txt
      Reconstruct the path list from a tree built with the defaults.

  find . | sgditto -n 4 | sgditto paths -n 4
      Round-trip: build a tree with 4-space indent, then reconstruct
      the original path list from it -- both sides need the same -n.

  sgditto paths1.txt paths2.txt
      Read paths from files instead of stdin.
EOF
}

case "${1:-}" in
    tree|paths) subcommand=$1; shift ;;
esac

while getopts "i:n:s:gh" opt; do
    case "$opt" in
        i) indent=$OPTARG ;;
        n) repeat_count=$OPTARG ;;
        s) separator=$OPTARG ;;
        g) gron_mode=1 ;;
        h) usage; exit 0 ;;
        *) usage >&2; exit 1 ;;
    esac
done
shift $((OPTIND - 1))

if [ -z "$separator" ]; then
    echo "sgditto: separator must not be empty" >&2
    exit 1
fi

if [ "$subcommand" = paths ]; then
    cat "$@" | awk -v sep="$separator" -v indent="$indent" -v repeat_count="$repeat_count" -v gron_mode="$gron_mode" '
function count_indent(line,    k, ilen) {
    ilen = length(indent)
    if (ilen == 0) return 0
    k = 0
    while (substr(line, 1, ilen) == indent) {
        line = substr(line, ilen + 1)
        k++
    }
    return k
}

{
    raw = $0
    sub(/[ \t\r]+$/, "", raw)
    if (raw == "") next

    k = count_indent(raw)
    depth = int(k / repeat_count)
    rest = substr(raw, k * length(indent) + 1)

    lineSuffix = ""
    if (gron_mode) {
        eq = index(rest, " = ")
        if (eq > 0) {
            lineSuffix = substr(rest, eq)
            rest = substr(rest, 1, eq - 1)
        }
    }

    stack[depth] = rest

    path = stack[0]
    for (d = 1; d <= depth; d++) path = path sep stack[d]

    print path lineSuffix
}
'
    exit 0
fi

cat "$@" | awk -v sep="$separator" -v indent="$indent" -v repeat_count="$repeat_count" -v gron_mode="$gron_mode" '
function esc_re(s,    out, i, c, special) {
    special = "\\.^$*+?()[]{}|"
    out = ""
    for (i = 1; i <= length(s); i++) {
        c = substr(s, i, 1)
        out = out (index(special, c) > 0 ? "\\" c : c)
    }
    return out
}

function add_node(key, parentKey, nodeName) {
    if (key in known) return
    known[key] = 1
    name[key] = nodeName
    childCount[parentKey]++
    childOf[parentKey, childCount[parentKey]] = key
}

function lc(s) {
    return tolower(s)
}

function sort_children(parentKey,    n, i, j, tmp) {
    n = childCount[parentKey]
    for (i = 2; i <= n; i++) {
        j = i
        while (j > 1 && lc(name[childOf[parentKey, j - 1]]) > lc(name[childOf[parentKey, j]])) {
            tmp = childOf[parentKey, j]
            childOf[parentKey, j] = childOf[parentKey, j - 1]
            childOf[parentKey, j - 1] = tmp
            j--
        }
    }
}

function repeat(str, times,    out, i) {
    out = ""
    for (i = 0; i < times; i++) out = out str
    return out
}

function emit(parentKey, depth,    i, k, pad) {
    sort_children(parentKey)
    pad = repeat(indent, depth * repeat_count)
    for (i = 1; i <= childCount[parentKey]; i++) {
        k = childOf[parentKey, i]
        print pad name[k] suffix[k]
        emit(k, depth + 1)
    }
}

BEGIN { sep_re = esc_re(sep) }

{
    line = $0
    gsub(/^[ \t]+|[ \t]+$/, "", line)
    if (line == "") next

    lineSuffix = ""
    if (gron_mode) {
        eq = index(line, " = ")
        if (eq > 0) {
            lineSuffix = substr(line, eq)
            line = substr(line, 1, eq - 1)
        }
    }

    n = split(line, parts, sep_re)
    parentKey = ""
    key = ""
    for (i = 1; i <= n; i++) {
        if (parts[i] == "") continue
        key = key SUBSEP parts[i]
        add_node(key, parentKey, parts[i])
        if (i == n) suffix[key] = lineSuffix
        parentKey = key
    }
}

END { emit("", 0) }
'
